# ── LLM Provider ─────────────────────────────────────────────────────────────
# "gemini" (default, primary) | "groq" | "ollama" (offline)
LLM_PROVIDER=gemini

# ── Gemini (primary LLM) ─────────────────────────────────────────────────────
# Get a key from https://aistudio.google.com — works with both "AIza..." and "AQ." formats.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Groq (fallback LLM) ──────────────────────────────────────────────────────
# Get a key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# ── Ollama (offline last-resort LLM) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# "auto" | "cpu" | "cuda"
EMBEDDING_DEVICE=auto

# ── Vector Store & Curriculum ────────────────────────────────────────────────
VECTORSTORE_DIR=./vectorstore
CURRICULUM_DIR=./sample_curriculum

# ── Uploads (per-session user files) ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
# Minimum cosine similarity for a chunk to count as relevant (higher = stricter).
SIMILARITY_THRESHOLD=0.05

# ── Database ─────────────────────────────────────────────────────────────────
# MySQL (default)
DATABASE_URL=mysql+pymysql://root:changeme@localhost:3306/ai_teaching_assistant
# For local dev without MySQL, use SQLite:
# DATABASE_URL=sqlite:///./syllabot.db

# ── Backend ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000