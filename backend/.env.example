# --- LLM Provider ---
# "ollama" (default, local, free) or "groq" (free tier, requires GROQ_API_KEY)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Groq (only needed if LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector Store ---
VECTORSTORE_DIR=./vectorstore

# --- Curriculum Source ---
CURRICULUM_DIR=./sample_curriculum

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
RETRIEVAL_TOP_K=5
# Min cosine similarity for a chunk to count as relevant (higher=stricter).
# Relevant content ~0.26-0.67; off-topic < 0. Default 0.20.
SIMILARITY_THRESHOLD=0.20

# --- MySQL (CHANGE THE PASSWORD) ---
DATABASE_URL=mysql+pymysql://root:changeme@localhost:3306/ai_teaching_assistant

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
